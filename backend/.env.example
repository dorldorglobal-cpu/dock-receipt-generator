# ─────────────────────────────────────────────────────────────────────────────
#  backend/.env  — copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Core
MONGODB_URI=
JWT_SECRET=
APP_PASSWORD_HASH=
FRONTEND_ORIGIN=
RENDER_EXTERNAL_URL=

# LLM extraction (AES / receipt parsing)
GROQ_API_KEY=

# Gmail (alerts + reminders, app password)
GMAIL_USER=
GMAIL_PASS=
ALERT_EMAIL=

# Gmail OAuth (Copart poller)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─────────────────────────────────────────────────────────────────────────────
#  AES / EEI export filing (CBP AES WebLink)
# ─────────────────────────────────────────────────────────────────────────────

# "test" → hand-offs + inquiries hit trade-test.cbp.dhs.gov (default).
# "prod" → live filing. Only set to prod AFTER CBP certifies the app as a
#          WebLink "Enabled Application". When set here it overrides the value
#          on the AES Settings page.
AES_ENV=test

# Public origin of THIS backend, used to build the wl_success_url / wl_nosed_url
# that CBP redirects to with the ITN. Must be reachable from the user's browser.
# Falls back to RENDER_EXTERNAL_URL when unset.
PUBLIC_BACKEND_URL=

# ITN poller — set to "on" to enable the background job that pulls ITNs back via
# the WebLink Inquiry API for filings that were handed off but have no ITN yet.
AES_ITN_POLLER=off
AES_ITN_GIVEUP_DAYS=10

# WebLink Inquiry API client certificate (PEM contents), issued by CBP during
# certification. Leave blank until then — the poller no-ops with a log line.
AES_INQUIRY_CERT=
AES_INQUIRY_KEY=
